# 0.0.0.0 when this box is the public proxy other machines (Render) will call.
PROXY_HOST=0.0.0.0
PROXY_HTTP_PORT=8888
PROXY_SOCKS_PORT=1080

# Required when PROXY_HOST is 0.0.0.0
PROXY_USER=zoyra
PROXY_PASSWORD=change-me

# Optional: Render (or API) outbound IP so only Zoyra can use this proxy.
# PROXY_ALLOW=1.2.3.4
