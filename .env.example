# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Where converted mp3 files are cached
DOWNLOAD_DIR=downloads
# Max search results per request
MAX_SEARCH_RESULTS=25
# Seconds to cache resolved YouTube stream URLs (they expire ~6h)
STREAM_URL_TTL=3600
# mp3 bitrate for /download
MP3_BITRATE=192
# Optional: YouTube cookies.txt contents (Netscape format) if YouTube blocks the server IP
YT_COOKIES=
# Or a path to the cookies.txt file (Render Secret File: /etc/secrets/cookies.txt)
YT_COOKIES_FILE=
# Optional: forward proxy for YouTube traffic. Point this at a SEPARATE host
# (home Mac/Pi with proxy/ running), not at Render itself.
# YT_PROXY=http://zoyra:secret@YOUR_HOME_IP:8888
# YT_PROXY=socks5://zoyra:secret@YOUR_HOME_IP:1080
YT_PROXY=
# Require this key on every /api/* call (header X-Zoyra-Key or ?key=). Leave empty to disable.
API_KEY=
# Webshare.io API key: proxy list is fetched automatically (alternative to YT_PROXY).
WEBSHARE_API_KEY=
# One or more proxies, comma separated; tried in turn when YouTube blocks one.
# YT_PROXY=http://user-1:pass@p.webshare.io:80,http://user-2:pass@p.webshare.io:80
